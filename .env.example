# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (or NEXT_PUBLIC_SUPABASE_ANON_KEY=)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth 2.1 (MCP / Apps SDK)
# OAUTH_ALLOWED_CLIENTS_JSON is a static allowlist for pre-provisioned clients (e.g. local dev).
# ChatGPT connects via Dynamic Client Registration (POST /oauth/register), so it does NOT need
# an entry here — DCR clients are persisted in the oauth_clients table (migration 014).
OAUTH_ALLOWED_CLIENTS_JSON='{"local-dev-client":["http://localhost:3000/dev/callback"]}'
OAUTH_SIGNING_SECRET=

# Gate ONLY the Supabase Authorization header login bypass (dev/preview convenience).
# Does NOT affect OAuth access_token bearer auth. prod: false; preview/dev/CI: true (optional).
OAUTH_ALLOW_AUTH_HEADER_LOGIN=false

# Base URL of the deployment. Used to derive the MCP resource identifier
# (<BASE_URL>/api/mcp) and share links. On Vercel this is auto-derived from
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_BRANCH_URL when unset.
BASE_URL=http://localhost:3000

# Optional: shareable ChatGPT app link shown as the "Open in ChatGPT" CTA.
# Leave unset until the app is published (the CTA is hidden when empty).
# NEXT_PUBLIC_CHATGPT_APP_URL=

# Cron protection (Vercel Cron Jobs). Optional.
# CRON_SECRET=

# Smoke test defaults (optional)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
CLIENT_ID=local-dev-client
REDIRECT_URI=http://localhost:3000/dev/callback
STATE=state-123
