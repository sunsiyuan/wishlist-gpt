# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth
OAUTH_ALLOWED_CLIENTS_JSON='{"local-dev-client":["http://localhost:3000/dev/callback"]}'
OAUTH_SIGNING_SECRET=

# OAuth bridge runtime
# Gate ONLY the Supabase Authorization header login bypass (dev/preview convenience).
# This does NOT affect OAuth access_token bearer auth.
# - prod: false
# - preview/dev/CI: true (optional)
OAUTH_ALLOW_AUTH_HEADER_LOGIN=false

# Smoke test defaults (optional)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
BASE_URL=http://localhost:3000
CLIENT_ID=local-dev-client
REDIRECT_URI=http://localhost:3000/dev/callback
STATE=state-123
