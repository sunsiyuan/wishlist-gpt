# Local development env. Copy to .env.local:  cp .env.local.example .env.local
#
# The Supabase values below are the standard local-dev defaults printed by `supabase start`
# (same for every local install — they only work against your local stack, safe to commit).
# If `supabase status` shows different keys, use those instead.

# --- Supabase (local, CLI v2.x demo keys — verified via `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- OAuth 2.1 (any non-empty secret is fine for local) ---
OAUTH_SIGNING_SECRET=local_dev_signing_secret_change_me
OAUTH_ALLOWED_CLIENTS_JSON={"local-dev-client":["http://localhost:3000/dev/callback"]}
OAUTH_ALLOW_AUTH_HEADER_LOGIN=true

# --- App ---
BASE_URL=http://localhost:3000
