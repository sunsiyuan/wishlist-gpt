{
  "name": "wishlist-gpt",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "smoke:all": "bash -lc './scripts/preflight.sh && ./scripts/smoke_oauth.sh && ./scripts/smoke_mcp.sh'",
    "smoke:staging": "bash -lc 'source scripts/lib/dotenv.sh; BASE_URL=\"$STAGING_BASE_URL\" OAUTH_SESSION_KEY=staging npm run smoke:all'",
    "smoke:prod": "bash -lc 'source scripts/lib/dotenv.sh; BASE_URL=\"$PROD_BASE_URL\" OAUTH_SESSION_KEY=prod npm run smoke:all'",
    "smoke:oauth": "bash -lc 'export EXPECT_SUPABASE_HEADER_BYPASS=skip; ./scripts/smoke_oauth.sh'",
    "smoke:mcp": "bash -lc './scripts/smoke_mcp.sh'",
    "smoke:preflight": "bash -lc './scripts/preflight.sh'"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.50.0",
    "country-to-currency": "2.0.2",
    "mcp-handler": "1.1.0",
    "next": "^16.1.1",
    "p-limit": "^7.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
